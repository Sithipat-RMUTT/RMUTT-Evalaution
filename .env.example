# =============================================================================
# RMUTT Evaluation System - Environment Configuration Template (.env.example)
# Copy this file to .env and configure strong, random secrets for your deployment.
# =============================================================================

# Application Ports
APP_HTTP_PORT=8000
APP_BACKEND_PORT=8001
PHPMYADMIN_PORT=8080

# Database Configuration
# Do not use 'root' in production! Use 'rmutt_app' with restricted privileges.
DB_HOST=db
DB_PORT=3306
DB_NAME=rmutt
DB_USER=rmutt_app
DB_PASS=replace_with_strong_app_db_password
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password

# Cryptographic Keys (MUST be cryptographically random strings >= 32 characters)
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=replace_with_at_least_32_character_secret_key_for_encryption
DATA_BLIND_INDEX_KEY=replace_with_at_least_32_character_secret_key_for_blind_index
COOKIE_VALIDATION_KEY=replace_with_at_least_32_character_secret_key_for_cookies

# Initial Seed Credentials (Used only during development/testing seed)
SEED_ADMIN_PASSWORD=replace_with_temporary_admin_password
SEED_DEFAULT_PASSWORD=replace_with_temporary_user_password
SEED_COMMITTEE_PASSWORD=replace_with_temporary_committee_password
SEED_DIRECTOR_PASSWORD=replace_with_temporary_director_password
